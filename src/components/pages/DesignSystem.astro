<section class="scroll-mt-24 px-6 py-20 md:px-12 md:py-24 xl:px-20">
  <span class="font-mono text-[10px] tracking-widest text-primary">
    CRIAM · SISTEMA VISIVO
  </span>
  <h1 class="font-display text-[38px] leading-[1.12] font-medium tracking-[-0.025em] md:text-[52px] mt-6">
    Materia. Luce. Movimento.
  </h1>
  <p class="mt-5 max-w-2xl text-sm leading-7 text-muted-foreground">
    Una grammatica architettonica: superfici in grafite, luce ambra, griglie
    precise. Il movimento accompagna, non interrompe.
  </p>
  <h2 class="mb-6 mt-14 font-display text-2xl">01 / Colore</h2>
  <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
    <div class="border border-border">
      <div class="h-24 bg-[#151819]"></div>
      <div class="p-4">
        <p class="text-sm">Grafite</p>
        <span class="font-mono text-[10px] text-muted-foreground">#151819</span>
      </div>
    </div>
    <div class="border border-border">
      <div class="h-24 bg-[#d9a95d]"></div>
      <div class="p-4">
        <p class="text-sm">Ambra</p>
        <span class="font-mono text-[10px] text-muted-foreground">#D9A95D</span>
      </div>
    </div>
    <div class="border border-border">
      <div class="h-24 bg-[#eeeae2]"></div>
      <div class="p-4">
        <p class="text-sm">Avorio</p>
        <span class="font-mono text-[10px] text-muted-foreground">#EEEAE2</span>
      </div>
    </div>
    <div class="border border-border">
      <div class="h-24 bg-[#dce0d5]"></div>
      <div class="p-4">
        <p class="text-sm">Salvia</p>
        <span class="font-mono text-[10px] text-muted-foreground">#DCE0D5</span>
      </div>
    </div>
  </div>
  <h2 class="mb-6 mt-14 font-display text-2xl">02 / Tipografia</h2>
  <div class="grid gap-7 border-y border-border py-8 md:grid-cols-3">
    <div>
      <span class="text-xs text-primary">Space Grotesk / Titoli</span>
      <p class="mt-4 font-display text-4xl">Più in alto.</p>
    </div>
    <div>
      <span class="text-xs text-primary">DM Sans / Testo</span>
      <p class="mt-4 text-base leading-7">
        La sicurezza si costruisce
        <br />
        un dettaglio alla volta.
      </p>
    </div>
    <div>
      <span class="text-xs text-primary">JetBrains Mono / Indicatori</span>
      <p class="mt-4 font-mono text-4xl">T 01 24/7</p>
    </div>
  </div>
  <h2 class="mb-6 mt-14 font-display text-2xl">03 / Tasti e componenti</h2>
  <div class="flex flex-wrap items-center gap-6">
    <a
      href="/contatti"
      class="group inline-flex min-h-12 items-center justify-center gap-4 border border-primary bg-primary px-6 py-3.5 text-[13px] font-semibold text-primary-foreground transition-all hover:bg-[#e8bb78] hover:shadow-[0_0_24px_#d9a95d25] active:scale-[0.98]"
    >
      Tasto principale
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-arrow-up-right transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        aria-hidden="true"
      >
        <path d="M7 7h10v10"></path>
        <path d="M7 17 17 7"></path>
      </svg>
    </a>
    <a
      href="/contatti"
      class="group inline-flex min-h-12 items-center justify-center gap-4 border border-primary bg-primary px-6 py-3.5 text-[13px] font-semibold text-primary-foreground transition-all hover:bg-[#e8bb78] hover:shadow-[0_0_24px_#d9a95d25] active:scale-[0.98] !border-white/25 !bg-transparent !text-foreground hover:!border-primary hover:!text-primary"
    >
      Tasto secondario
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-arrow-up-right transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        aria-hidden="true"
      >
        <path d="M7 7h10v10"></path>
        <path d="M7 17 17 7"></path>
      </svg>
    </a>
    <button
      aria-label="Pulsante piano uno"
      class="flex h-12 w-12 items-center justify-center rounded-full border border-primary bg-primary/10 font-mono text-primary shadow-[0_0_16px_#d9a95d20]"
    >
      1
    </button>
    <span class="border border-primary/30 bg-black/30 px-6 py-4 font-mono text-3xl text-primary">
      T ↑
    </span>
  </div>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    <div class="border border-border bg-card p-7">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-wrench text-primary"
        aria-hidden="true"
      >
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"></path>
      </svg>
      <h3 class="mt-5 font-display text-2xl">Manutenzione.</h3>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        Card a griglia, bordi sottili e icone leggere. Porte che si aprono
        all’hover nella sezione servizi.
      </p>
    </div>
    <div class="border border-border p-7">
      <div class="mb-7 flex items-center gap-3 font-mono text-[10px] tracking-[0.14em] text-[#a7acac]">
        <span class="flex h-6 w-6 items-center justify-center border border-primary/40 text-primary">
          2
        </span>
        <span>PIANO 2</span>
        <span class="h-px w-8 bg-current opacity-30"></span>
        <span>SERVIZI</span>
      </div>
      <h3 class="font-display text-2xl">Movimento, con misura.</h3>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        Porte: 700 ms. Audio disattivato di default. Parallasse disattivato con
        movimento ridotto. Focus ambra sempre visibile.
      </p>
    </div>
  </div>
</section>
